/* packageAdmin/stores/stores.wxss */
.s-line1 { display: flex; align-items: center; }
.s-name { font-size: 29rpx; font-weight: 700; }
.s-line1 .tag { margin-left: auto; }
.s-code { font-size: 22rpx; color: var(--muted); margin-top: 6rpx; letter-spacing: 1rpx; }
.s-line { font-size: 25rpx; color: var(--text); margin-top: 14rpx; line-height: 1.6; }
.s-phone {
  font-size: 25rpx; color: var(--brand);
  margin-top: 14rpx; background: var(--brand-light);
  border-radius: 12rpx; padding: 14rpx 20rpx; display: inline-block;
}
.retry { margin-top: 20rpx; }
