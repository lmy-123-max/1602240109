<!--packageAdmin/stores/stores.wxml-->
<block wx:if="{{authState === 'checking'}}">
  <view class="loading-tip">加载中...</view>
</block>

<block wx:elif="{{authState !== 'ready'}}">
  <view class="card"><view class="empty"><text class="empty-ico">🔐</text>需要管理员工号
    <button class="btn-primary retry" bindtap="goProfile">去「我的」页绑定工号</button></view></view>
</block>

<block wx:else>
  <view class="sect">门店信息</view>
  <block wx:if="{{loading}}">
    <view class="card"><view class="loading-tip">门店加载中...</view></view>
  </block>
  <view class="card" wx:elif="{{!list.length}}"><view class="empty"><text class="empty-ico">🏠</text>暂无门店数据</view></view>
  <block wx:else>
    <view class="card s-card" wx:for="{{list}}" wx:key="id">
      <view class="s-line1">
        <text class="s-name">{{item.name}}</text>
        <text class="tag {{item.open ? 'tag-green' : 'tag-gray'}}">{{item.open ? '营业中' : '停业'}}</text>
      </view>
      <view class="s-code">{{item.code}}</view>
      <view class="s-line">📍 {{item.address}}</view>
      <view class="s-line">🕘 开诊时间：{{item.openTime || '-'}}</view>
      <view class="s-phone" data-phone="{{item.phone}}" bindtap="onCall">📞 {{item.phone}}（点击拨打）</view>
    </view>
  </block>
  <view class="footer-tip">门店档案 · 患者端首页门店切换与此同步</view>
</block>
