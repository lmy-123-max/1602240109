<!--packageAdmin/doctors/doctors.wxml-->
<block wx:if="{{authState === 'checking'}}">
  <view class="loading-tip">加载中...</view>
</block>

<block wx:elif="{{authState !== 'ready'}}">
  <view class="card"><view class="empty"><text class="empty-ico">🔐</text>需要管理员工号
    <button class="btn-primary retry" bindtap="goProfile">去「我的」页绑定工号</button></view></view>
</block>

<block wx:else>
  <view class="sect">医生团队 · 按门店</view>
  <block wx:if="{{loading}}">
    <view class="card"><view class="loading-tip">医生信息加载中...</view></view>
  </block>
  <view class="card" wx:elif="{{!groups.length}}"><view class="empty"><text class="empty-ico">🦷</text>暂无医生数据</view></view>
  <block wx:else>
    <view class="card d-store" wx:for="{{groups}}" wx:for-item="g" wx:key="storeName">
      <view class="d-store-name">🏠 {{g.storeName}}</view>
      <view class="d-store-addr">{{g.address}}</view>
      <view class="d-doc" wx:for="{{g.doctors}}" wx:for-item="d" wx:key="id">
        <view class="d-avatar">{{d.name[0]}}</view>
        <view class="d-main">
          <view class="d-line1">
            <text class="d-name">{{d.name}}</text>
            <text class="d-title">{{d.title}}</text>
            <text class="d-rating">★ {{d.rating}}</text>
          </view>
          <view class="d-spec" wx:if="{{d.specialty}}">擅长：{{d.specialty}}</view>
          <view class="d-intro" wx:if="{{d.intro}}">{{d.intro}}</view>
        </view>
      </view>
      <view class="d-empty" wx:if="{{!g.doctors.length}}">该门店暂无出诊医生</view>
    </view>
  </block>
  <view class="footer-tip">医生信息由总部统一维护</view>
</block>
