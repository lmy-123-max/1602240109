<!--packageAdmin/notices/notices.wxml-->
<block wx:if="{{authState === 'checking'}}">
  <view class="loading-tip">加载中...</view>
</block>

<block wx:elif="{{authState !== 'ready'}}">
  <view class="card"><view class="empty"><text class="empty-ico">🔐</text>需要管理员工号
    <button class="btn-primary retry" bindtap="goProfile">去「我的」页绑定工号</button></view></view>
</block>

<block wx:else>
  <view class="sect">发布公告</view>
  <view class="card form-card">
    <view class="f-item">
      <view class="f-label">标题 <text class="f-req">*</text></view>
      <input class="f-input" placeholder="公告标题" value="{{title}}" bindinput="onTitle" />
    </view>
    <view class="f-item">
      <view class="f-label">内容</view>
      <textarea class="f-area" placeholder="公告正文，会展示在患者端首页" value="{{content}}" bindinput="onContent" />
    </view>
    <view class="f-item f-row">
      <picker range="{{tags}}" value="{{tagIndex}}" bindchange="onTag">
        <view class="f-tag">标签：{{tags[tagIndex]}} ▾</view>
      </picker>
      <button class="btn-primary f-publish" bindtap="onPublish" disabled="{{submitting}}">
        {{submitting ? '发布中…' : '发布公告'}}
      </button>
    </view>
  </view>

  <view class="sect">已发布公告</view>
  <block wx:if="{{loading}}">
    <view class="card"><view class="loading-tip">公告加载中...</view></view>
  </block>
  <view class="card" wx:elif="{{!list.length}}"><view class="empty"><text class="empty-ico">📢</text>还没有公告</view></view>
  <block wx:else>
    <view class="card n-card {{item.on ? '' : 'n-off'}}" wx:for="{{list}}" wx:key="id">
      <view class="n-line1">
        <text class="tag tag-orange">{{item.tag}}</text>
        <text class="n-title">{{item.title}}</text>
        <text class="tag {{item.on ? 'tag-green' : 'tag-gray'}}">{{item.on ? '上架中' : '已下架'}}</text>
      </view>
      <view class="n-content" wx:if="{{item.content}}">{{item.content}}</view>
      <view class="n-foot">
        <text class="n-date">{{item.date}}</text>
        <view class="n-toggle {{item.on ? 'n-toggle-danger' : 'n-toggle-ok'}}" data-id="{{item.id}}" data-on="{{item.on}}" bindtap="onToggle">
          {{item.on ? '下架' : '上架'}}
        </view>
      </view>
    </view>
  </block>
  <view class="footer-tip">公告实时展示在患者端首页</view>
</block>
