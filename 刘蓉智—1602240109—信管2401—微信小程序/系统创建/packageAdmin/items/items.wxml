<!--packageAdmin/items/items.wxml-->
<block wx:if="{{authState === 'checking'}}">
  <view class="loading-tip">加载中...</view>
</block>

<block wx:elif="{{authState !== 'ready'}}">
  <view class="card"><view class="empty"><text class="empty-ico">🔐</text>需要管理员工号
    <button class="btn-primary retry" bindtap="goProfile">去「我的」页绑定工号</button></view></view>
</block>

<block wx:else>
  <view class="sect">治疗项目价目</view>
  <block wx:if="{{loading}}">
    <view class="card"><view class="loading-tip">价目加载中...</view></view>
  </block>
  <view class="card" wx:elif="{{!groups.length}}"><view class="empty"><text class="empty-ico">💉</text>暂无项目数据</view></view>
  <block wx:else>
    <view class="card i-cat" wx:for="{{groups}}" wx:for-item="g" wx:key="category">
      <view class="i-cat-name">{{g.category}}</view>
      <view class="i-head">
        <text class="i-h-name">项目</text>
        <text class="i-h-price">定价</text>
        <text class="i-h-cost">材料成本</text>
      </view>
      <view class="i-row" wx:for="{{g.items}}" wx:for-item="it" wx:key="id">
        <view class="i-name">
          <view class="i-n">{{it.name}} <text class="ins-tag ins-{{it.insCls}}">{{it.insText}}</text></view>
          <view class="i-code">{{it.code}} · 每{{it.unit}}</view>
        </view>
        <view class="i-price">¥{{it.priceText}}</view>
        <view class="i-cost">¥{{it.costText}}</view>
      </view>
    </view>
  </block>
  <view class="footer-tip">定价与材料成本一览 · 医保：甲类统筹全额报销、乙类报销 70%、自费不报销</view>
</block>
