<!--packageAdmin/staff/staff.wxml-->
<block wx:if="{{authState === 'checking'}}">
  <view class="loading-tip">加载中...</view>
</block>

<block wx:elif="{{authState !== 'ready'}}">
  <view class="card"><view class="empty"><text class="empty-ico">🔐</text>需要管理员工号
    <button class="btn-primary retry" bindtap="goProfile">去「我的」页绑定工号</button></view></view>
</block>

<block wx:else>
  <!-- 增设工作人员：门店管理员增设门店工作人员，总部管理员可增设两级管理员 -->
  <view class="sect">增设工作人员</view>
  <view class="card form-card">
    <view class="f-item">
      <view class="f-label">姓名 <text class="f-req">*</text></view>
      <input class="f-input" placeholder="如 王店长" value="{{name}}" bindinput="onName" />
    </view>
    <view class="f-item">
      <view class="f-label">赋予身份</view>
      <picker range="{{staffInfo.role === 'hq_admin' ? rolesHq : roles}}" range-key="label"
        value="{{staffInfo.role === 'hq_admin' ? roleIndexHq : roleIndex}}"
        bindchange="onRole">
        <view class="f-tag">{{(staffInfo.role === 'hq_admin' ? rolesHq[roleIndexHq] : roles[roleIndex]).label}} ▾</view>
      </picker>
    </view>
    <view class="f-item" wx:if="{{staffInfo.role === 'hq_admin'}}">
      <view class="f-label">归属门店（增设门店管理员时必选）</view>
      <picker range="{{stores}}" range-key="name" value="{{storeIndex}}" bindchange="onStore">
        <view class="f-tag">{{storeIndex >= 0 ? stores[storeIndex].name : '请选择门店 ▾'}}</view>
      </picker>
    </view>
    <button class="btn-primary st-submit" bindtap="onAdd" disabled="{{submitting}}">
      {{submitting ? '提交中…' : '新增该工作人员'}}
    </button>
    <view class="st-tip">💡 新增后系统自动分配工号（S2xx 门店 / H3xx 总部），员工在「我的」页绑定工号即可进入管理工作台；患者与牙医走「注册 / 入驻」自助开通。</view>
  </view>

  <!-- 工作人员列表 -->
  <view class="sect">工作人员列表</view>
  <block wx:if="{{loading}}">
    <view class="card"><view class="loading-tip">加载中...</view></view>
  </block>
  <view class="card" wx:elif="{{!list.length}}"><view class="empty"><text class="empty-ico">👥</text>暂无其他工作人员</view></view>
  <block wx:else>
    <view class="card s-card" wx:for="{{list}}" wx:key="staffCode">
      <view class="s-line1">
        <view class="s-badge {{item.role}}">{{item.role === 'hq_admin' ? '🏢' : '🏪'}}</view>
        <view class="s-main">
          <view class="s-name">{{item.name}} <text wx:if="{{item.mine}}" class="tag tag-blue">当前账号</text></view>
          <view class="s-code">工号 {{item.staffCode}} · {{item.storeName}}</view>
        </view>
        <view class="s-tag {{item.role === 'hq_admin' ? 's-hq' : 's-store'}}">{{item.roleText}}</view>
      </view>
      <view class="s-foot">
        <text class="tag {{item.bound ? 'tag-green' : 'tag-gray'}}">{{item.bound ? '已绑定登录' : '待绑定'}}</text>
        <view class="s-off" data-code="{{item.staffCode}}" data-name="{{item.name}}" bindtap="onOff">离职移除</view>
      </view>
    </view>
  </block>
  <view class="footer-tip">权限说明：门店管理员仅可增设本门店工作人员；总部管理员可增设门店/总部两级管理员；每名员工的进入均有登录留痕</view>
</block>
