<!--packageAdmin/logs/logs.wxml— 操作留痕 -->
<block wx:if="{{authState === 'checking'}}">
  <view class="loading-tip">身份检查中...</view>
</block>

<block wx:elif="{{authState === 'signed-out'}}">
  <view class="card">
    <view class="empty"><text class="empty-ico">🔐</text>请先登录，再绑定管理员工号查看留痕</view>
    <login-panel bind:signedin="onSignedIn" />
  </view>
</block>

<block wx:elif="{{authState === 'denied'}}">
  <view class="card"><view class="empty"><text class="empty-ico">🔐</text>需要管理员工号（S201/S202/H301）
    <button class="btn-primary retry" bindtap="goProfile">去「我的」页绑定工号</button></view></view>
</block>

<block wx:else>
  <view class="lg-hero">
    <view class="lg-title">增减操作留痕</view>
    <view class="lg-sub">人员增减、公告发布、预约确认、账户注销全程留痕，符合《个人信息保护法》第 55 条处理记录要求</view>
  </view>

  <view class="stat card stat2">
    <view class="stat-item">
      <view class="stat-num">{{statTotal}}</view><view class="stat-label">留痕总数</view>
    </view>
    <view class="stat-item">
      <view class="stat-num stat-mint">{{statAdd}}</view><view class="stat-label">新增</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{statStatus}}</view><view class="stat-label">预约确认</view>
    </view>
    <view class="stat-item">
      <view class="stat-num stat-warn">{{statOff + statCancel}}</view><view class="stat-label">停用/注销</view>
    </view>
  </view>

  <view class="card lg-filter-card">
    <view class="lg-tabs">
      <view class="lg-tab {{curFilter === 'ALL' ? 'on' : ''}}" data-key="ALL" bindtap="onFilter">全部</view>
      <view class="lg-tab {{curFilter === 'staff' ? 'on' : ''}}" data-key="staff" bindtap="onFilter">人员增减</view>
      <view class="lg-tab {{curFilter === 'notice' ? 'on' : ''}}" data-key="notice" bindtap="onFilter">公告</view>
      <view class="lg-tab {{curFilter === 'appointment' ? 'on' : ''}}" data-key="appointment" bindtap="onFilter">预约</view>
      <view class="lg-tab {{curFilter === 'patient' ? 'on' : ''}}" data-key="patient" bindtap="onFilter">注销</view>
    </view>
    <input class="lg-search" placeholder="搜索操作人 / 对象 / 说明" value="{{keyword}}" bindinput="onKeyword" />
  </view>

  <block wx:if="{{loading}}">
    <view class="card"><view class="loading-tip">留痕记录加载中...</view></view>
  </block>
  <block wx:elif="{{list.length}}">
    <view class="card lg-item" wx:for="{{list}}" wx:key="id">
      <view class="lg-head">
        <view class="tag {{item.actionCls}}">{{item.actionText}}</view>
        <view class="lg-target">{{item.targetDesc}}</view>
      </view>
      <view class="lg-line">操作人：{{item.operator}} · {{item.roleText}}</view>
      <view class="lg-line" wx:if="{{item.detail}}">{{item.detail}}</view>
      <view class="lg-time">{{item.timeText}}</view>
    </view>
  </block>
  <block wx:else>
    <view class="card"><view class="empty"><text class="empty-ico">📜</text>暂无符合条件的留痕记录</view></view>
  </block>

  <view class="footer-tip">操作留痕仅管理人员可查看，记录不可篡改、不可删除</view>
</block>
