<!--packageAdmin/workbench/workbench.wxml-->
<block wx:if="{{authState === 'checking'}}">
  <view class="loading-tip">身份检查中...</view>
</block>

<block wx:elif="{{authState === 'signed-out'}}">
  <view class="wb-hero wb-hero-sm">
    <view class="wb-hero-title">管理工作台</view>
    <view class="wb-hero-sub">请先登录，再绑定管理员工号进入</view>
  </view>
  <view class="card">
    <login-panel bind:signedin="onSignedIn" />
  </view>
</block>

<block wx:elif="{{authState === 'denied'}}">
  <view class="card deny-card">
    <view class="empty">
      <text class="empty-ico">🔐</text>
      尚未绑定管理员工号（S201/S202 门店管理员、H301 总部管理员）
      <button class="btn-primary retry" bindtap="goProfile">去「我的」页绑定工号</button>
    </view>
  </view>
</block>

<block wx:else>
  <view class="wb-hero">
    <view class="wb-hero-top">
      <view class="wb-role">{{staffInfo.role === 'hq_admin' ? '🏢 总部管理工作台' : '🏪 门店管理工作台'}}</view>
      <view class="wb-code">工号 {{staffInfo.staffCode}}</view>
    </view>
    <view class="wb-name">{{overview ? overview.storeName : ''}}</view>
    <view class="wb-sub">{{staffInfo.name}} · {{staffInfo.role === 'hq_admin' ? '管辖全部门店' : '管辖本门店'}}</view>
  </view>

  <view class="stat card">
    <view class="stat-item">
      <view class="stat-num">{{overview.todayAppts || 0}}</view>
      <view class="stat-label">今日预约</view>
    </view>
    <view class="stat-item">
      <view class="stat-num stat-warn">{{overview.waitConfirm || 0}}</view>
      <view class="stat-label">待确认</view>
    </view>
    <view class="stat-item">
      <view class="stat-num stat-mint">{{overview.inClinic || 0}}</view>
      <view class="stat-label">在诊</view>
    </view>
  </view>

  <view class="stat card stat2">
    <view class="stat-item">
      <view class="stat-num stat-mint">¥{{overview.revenueText || '0'}}</view>
      <view class="stat-label">本月营收</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{overview.patientCount || 0}}</view>
      <view class="stat-label">接诊患者</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{overview.doctorCount || 0}}</view>
      <view class="stat-label">在岗牙医</view>
    </view>
  </view>

  <!-- 医保与合规指标 -->
  <view class="stat card stat2">
    <view class="stat-item">
      <view class="stat-num stat-ins">¥{{overview.insuranceText || '0'}}</view>
      <view class="stat-label">医保统筹</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">¥{{overview.selfText || '0'}}</view>
      <view class="stat-label">患者自付</view>
    </view>
    <view class="stat-item">
      <view class="stat-num stat-warn">{{overview.monthCancel || 0}}</view>
      <view class="stat-label">本月注销</view>
    </view>
  </view>

  <view class="sect">管理功能</view>
  <view class="card func-grid">
    <view class="func-item" bindtap="goAppts">
      <view class="func-ico f-blue">📅</view>
      <view class="func-name">预约管理</view>
      <view class="func-desc">确认 · 取消 · 查询</view>
    </view>
    <view class="func-item" bindtap="goNotices">
      <view class="func-ico f-orange">📢</view>
      <view class="func-name">公告管理</view>
      <view class="func-desc">发布 · 下架</view>
    </view>
    <view class="func-item" bindtap="goDoctors">
      <view class="func-ico f-green">🦷</view>
      <view class="func-name">医生团队</view>
      <view class="func-desc">出诊牙医一览</view>
    </view>
    <view class="func-item" bindtap="goStaff">
      <view class="func-ico f-teal">👥</view>
      <view class="func-name">人员账号</view>
      <view class="func-desc">增设 · 离职移除</view>
    </view>
  </view>
  <view class="card func-grid">
    <view class="func-item" bindtap="goItems">
      <view class="func-ico f-purple">💉</view>
      <view class="func-name">价目表</view>
      <view class="func-desc">治疗项目与定价</view>
    </view>
    <view class="func-item" bindtap="goStores">
      <view class="func-ico f-blue">🏠</view>
      <view class="func-name">门店信息</view>
      <view class="func-desc">地址 · 电话 · 开诊</view>
    </view>
    <view class="func-item" bindtap="goLogs">
      <view class="func-ico f-red">📜</view>
      <view class="func-name">操作留痕</view>
      <view class="func-desc">增减 · 注销 · 全程记录</view>
    </view>
  </view>

  <view class="footer-tip">管理工作台 · 数据与患者端 / 医生端实时互通</view>
</block>
