/* packageAdmin/appointments/appointments.wxss */
.filters {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 24rpx;
}
.filter-chip {
  background: #f4f7fb; border-radius: 30rpx;
  padding: 12rpx 26rpx; font-size: 24rpx; color: var(--text);
  display: flex; align-items: center; gap: 8rpx;
}
.filter-on { background: var(--brand-light); color: var(--brand); }
.filter-clear { color: inherit; padding-left: 6rpx; }
.filter-count { margin-left: auto; font-size: 22rpx; color: var(--muted); }

.a-line1 { display: flex; align-items: center; gap: 12rpx; }
.a-no { font-size: 24rpx; color: var(--muted); font-family: monospace; }
.a-today {
  font-size: 20rpx; color: #fff; background: var(--warn);
  border-radius: 8rpx; padding: 2rpx 10rpx;
}
.a-line1 .tag { margin-left: auto; }
.a-info { font-size: 24rpx; color: var(--muted); margin-top: 10rpx; }
.a-line2 { display: flex; align-items: center; margin-top: 12rpx; font-size: 28rpx; font-weight: 600; }
.a-phone { margin-left: auto; font-size: 24rpx; font-weight: 400; color: var(--brand); }
.a-ops { display: flex; gap: 16rpx; margin-top: 18rpx; align-items: center; }
.op-btn {
  font-size: 25rpx; color: #fff; border-radius: 30rpx;
  padding: 0 34rpx; line-height: 62rpx; margin: 0;
}
.op-btn::after { border: none; }
.op-blue { background: var(--brand); }
.op-danger { background: #fff; color: var(--danger); border: 1rpx solid #f3d3d0; }
.a-none { font-size: 23rpx; color: var(--muted); }
.retry { margin-top: 20rpx; }
