<!--packageDoctor/schedule/schedule.wxml-->
<block wx:if="{{authState === 'checking'}}">
  <view class="loading-tip">加载中...</view>
</block>

<block wx:elif="{{authState !== 'ready'}}">
  <view class="card"><view class="empty"><text class="empty-ico">🔐</text>需要牙医身份
    <button class="btn-primary retry" bindtap="goProfile">去「我的」页绑定工号</button></view></view>
</block>

<block wx:else>
  <view class="sect">未来出诊安排 · {{staffInfo.name}}</view>
  <block wx:if="{{loading}}">
    <view class="card"><view class="loading-tip">排班加载中...</view></view>
  </block>
  <view class="card" wx:elif="{{!groups.length}}"><view class="empty"><text class="empty-ico">🗓</text>暂无排班，请联系门店管理员安排</view></view>
  <block wx:else>
    <view class="card sch-card" wx:for="{{groups}}" wx:for-item="g" wx:key="date">
      <view class="sch-date">{{g.date}} <text class="sch-week">{{g.weekday}}</text></view>
      <view class="sch-item" wx:for="{{g.items}}" wx:for-item="s" wx:key="id">
        <text class="sch-slot">{{s.slotText}}</text>
        <text class="sch-quota {{s.full ? 'sch-full' : ''}}">{{s.off ? '已停诊' : s.quotaText}}</text>
        <text class="tag {{s.off ? 'tag-gray' : (s.full ? 'tag-orange' : 'tag-green')}}">{{s.off ? '停诊' : (s.full ? '约满' : '可约')}}</text>
      </view>
    </view>
  </block>
  <view class="footer-tip">排班由门店管理员维护，患者端号源与此实时同步</view>
</block>
