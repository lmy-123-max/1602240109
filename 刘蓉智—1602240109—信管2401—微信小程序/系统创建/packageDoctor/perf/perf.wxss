/* packageDoctor/perf/perf.wxss */
.perf-hero {
  background: linear-gradient(150deg, #12b886, #0ca678);
  padding: 52rpx 40rpx 44rpx;
  color: #fff;
  border-radius: 0 0 40rpx 40rpx;
  text-align: center;
}
.perf-month { font-size: 25rpx; opacity: 0.9; }
.perf-revenue { font-size: 64rpx; font-weight: 800; margin-top: 14rpx; letter-spacing: -1rpx; }
.perf-name { font-size: 24rpx; opacity: 0.85; margin-top: 10rpx; }

.stat { display: flex; margin-top: -36rpx; position: relative; padding: 28rpx 0; }
.stat-item { flex: 1; text-align: center; }
.stat-num { font-size: 38rpx; font-weight: 700; color: var(--brand); }
.stat-warn { color: var(--warn); }
.stat-label { font-size: 23rpx; color: var(--muted); margin-top: 6rpx; }

.perf-note { }
.perf-note-title { font-size: 27rpx; font-weight: 600; margin-bottom: 12rpx; }
.perf-note-line { font-size: 24rpx; color: var(--muted); line-height: 1.9; }
.retry { margin-top: 20rpx; }
