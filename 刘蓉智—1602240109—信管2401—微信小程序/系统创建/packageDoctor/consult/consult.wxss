/* packageDoctor/consult/consult.wxss */
.c-head { padding-bottom: 22rpx; }
.c-title { font-size: 32rpx; font-weight: 700; }
.c-sub { font-size: 23rpx; color: var(--muted); margin-top: 8rpx; }

.f-item { margin-bottom: 26rpx; }
.f-item:last-child { margin-bottom: 0; }
.f-label { font-size: 25rpx; color: var(--muted); margin-bottom: 10rpx; }
.f-req { color: var(--danger); }
.f-input {
  background: #f4f7fb; border-radius: 14rpx;
  padding: 18rpx 24rpx; font-size: 27rpx;
}
.f-area {
  background: #f4f7fb; border-radius: 14rpx;
  padding: 18rpx 24rpx; font-size: 27rpx;
  width: 100%; height: 140rpx; box-sizing: border-box;
}
.f-row { display: flex; gap: 20rpx; }
.f-col { flex: 1; min-width: 0; }
.f-date {
  background: #f4f7fb; border-radius: 14rpx;
  padding: 18rpx 24rpx; font-size: 27rpx;
  display: flex; align-items: center;
}
.f-date-text { flex: 1; color: var(--text); }
.f-clear { color: var(--muted); padding-left: 16rpx; }
.submit { margin: 10rpx 24rpx; border-radius: 44rpx; }
.retry { margin-top: 20rpx; }
