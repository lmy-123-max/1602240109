<!--packageDoctor/consult/consult.wxml-->
<block wx:if="{{authState === 'checking'}}">
  <view class="loading-tip">加载中...</view>
</block>

<block wx:elif="{{authState !== 'ready'}}">
  <view class="card"><view class="empty"><text class="empty-ico">🔐</text>需要牙医身份
    <button class="btn-primary retry" bindtap="goProfile">去「我的」页绑定工号</button></view></view>
</block>

<block wx:else>
  <view class="c-head card">
    <view class="c-title">完成就诊 · {{patientName}}</view>
    <view class="c-sub">提交后自动写入患者病历，并生成待支付缴费单</view>
  </view>

  <view class="card form-card">
    <view class="f-item">
      <view class="f-label">诊断结果 <text class="f-req">*</text></view>
      <input class="f-input" placeholder="如：中龋 / 慢性牙龈炎" value="{{form.diagnosis}}" data-key="diagnosis" bindinput="onField" />
    </view>
    <view class="f-item">
      <view class="f-label">牙位</view>
      <input class="f-input" placeholder="如：左下 6（36）" value="{{form.tooth}}" data-key="tooth" bindinput="onField" />
    </view>
    <view class="f-item">
      <view class="f-label">处置 / 治疗项目</view>
      <textarea class="f-area" placeholder="如：树脂充填 + 抛光" value="{{form.treatment}}" data-key="treatment" bindinput="onField" />
    </view>
    <view class="f-item f-row">
      <view class="f-col">
        <view class="f-label">本次费用（元）</view>
        <input class="f-input" type="digit" placeholder="0" value="{{form.total}}" data-key="total" bindinput="onField" />
      </view>
      <view class="f-col">
        <view class="f-label">下次复诊</view>
        <view class="f-date">
          <picker mode="date" start="{{minDate}}" value="{{form.nextVisit}}" bindchange="onDate">
            <view class="f-date-text">{{form.nextVisit || '选择日期'}}</view>
          </picker>
          <text wx:if="{{form.nextVisit}}" class="f-clear" bindtap="clearDate">✕</text>
        </view>
      </view>
    </view>
  </view>

  <button class="btn-primary submit" bindtap="onSubmit" disabled="{{submitting}}">
    {{submitting ? '提交中…' : '确认完成就诊'}}
  </button>
  <view class="footer-tip">费用将生成待支付缴费单；系统按医保规则自动核算：甲类全额纳入统筹、乙类报销 70%、种植/正畸/修复类自费</view>
</block>
