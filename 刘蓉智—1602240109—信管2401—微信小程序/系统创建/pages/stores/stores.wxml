<!--pages/stores/stores.wxml-->
<view class="sect">门诊门店</view>
<block wx:if="{{loading}}">
  <view class="card"><view class="loading-tip">门店信息加载中...</view></view>
</block>
<block wx:elif="{{loadError}}">
  <view class="card">
    <view class="empty">
      <text class="empty-ico">⚠️</text>
      {{loadError}}
      <button class="btn-primary retry" bindtap="load">重新加载</button>
    </view>
  </view>
</block>
<block wx:else>
  <view class="card s-card" wx:for="{{list}}" wx:key="id">
    <view class="s-line1">
      <text class="s-name">{{item.name}}</text>
      <text class="tag {{item.open ? 'tag-green' : 'tag-gray'}}">{{item.open ? '营业中' : '停业'}}</text>
    </view>
    <view class="s-code">{{item.code}}</view>
    <view class="s-line">📍 {{item.address}}</view>
    <view class="s-line">🕘 开诊时间：{{item.openTime || '-'}}</view>
    <view class="s-ops">
      <view class="s-btn s-call" data-phone="{{item.phone}}" bindtap="onCall">📞 {{item.phone}}</view>
      <view class="s-btn s-map" data-index="{{index}}" bindtap="openMap">🗺 查看位置</view>
    </view>
  </view>
</block>
<view class="footer-tip">如需就诊请提前在「预约」中挂号</view>
