/* pages/profile/profile.wxss */
.me-hero {
  background: linear-gradient(150deg, #2f9bf5, #0d5fb3);
  padding: 60rpx 32rpx 50rpx;
  text-align: center;
  color: #fff;
  border-radius: 0 0 40rpx 40rpx;
}
.avatar {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: rgba(255,255,255,0.25);
  font-size: 48rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 16rpx;
}
.avatar-guest { font-size: 56rpx; }
.me-name { font-size: 34rpx; font-weight: 700; }
.me-sub { font-size: 24rpx; opacity: 0.85; margin-top: 8rpx; }

.stat { display: flex; margin-top: -40rpx; position: relative; padding: 26rpx 0; }
.stat-item { flex: 1; text-align: center; }
.stat-num { font-size: 40rpx; font-weight: 700; color: var(--brand); }
.stat-warn { color: var(--warn); }
.stat-mint { color: var(--mint); }
.stat-label { font-size: 24rpx; color: var(--muted); margin-top: 6rpx; }

.menu { padding: 8rpx 28rpx; }
.menu-item { display: flex; align-items: center; padding: 26rpx 0; font-size: 28rpx; }
.menu-item + .menu-item { border-top: 1rpx solid var(--line); }
.mi-ico { margin-right: 18rpx; font-size: 32rpx; }
.mi-arrow { margin-left: auto; color: var(--muted); font-size: 34rpx; }

.logout { margin: 10rpx 24rpx 30rpx; }
.footer-tip { text-align: center; color: var(--muted); font-size: 22rpx; padding-bottom: 40rpx; }

/* ---- 员工工作台 ---- */
.staff-card { padding: 26rpx 28rpx; }
.staff-row { display: flex; align-items: center; }
.staff-badge {
  width: 76rpx; height: 76rpx; border-radius: 20rpx;
  background: #eaf3fe; font-size: 36rpx;
  display: flex; align-items: center; justify-content: center;
}
.staff-badge-doctor { background: #e8f2ff; }
.staff-badge-store_admin { background: #fff3e5; }
.staff-badge-hq_admin { background: #efeaff; }
.staff-main { flex: 1; margin-left: 20rpx; min-width: 0; }
.staff-name { font-size: 28rpx; font-weight: 600; }
.staff-code { font-size: 22rpx; color: var(--muted); margin-top: 6rpx; }
.staff-unbind {
  font-size: 24rpx; color: #c0453f; padding: 8rpx 18rpx;
  border: 1rpx solid #f3d3d0; border-radius: 26rpx;
}
.btn-staff {
  margin-top: 22rpx; width: 100%;
  background: linear-gradient(135deg, #2f9bf5, #0d5fb3);
  color: #fff; font-size: 28rpx; font-weight: 600;
  border-radius: 44rpx; padding: 4rpx 0;
}
.btn-staff::after { border: none; }
.staff-bind-title { font-size: 27rpx; font-weight: 600; }
.staff-bind-row { display: flex; align-items: center; gap: 16rpx; margin-top: 18rpx; }
.staff-input {
  flex: 1; background: #f4f7fb; border-radius: 14rpx;
  padding: 16rpx 22rpx; font-size: 27rpx;
}
.btn-staff-sm {
  background: var(--brand); color: #fff; font-size: 26rpx;
  border-radius: 14rpx; padding: 0 34rpx; line-height: 66rpx;
}
.btn-staff-sm::after { border: none; }
.btn-staff-sm[disabled] { opacity: 0.6; }
.staff-hint { font-size: 21rpx; color: var(--muted); margin-top: 14rpx; line-height: 1.6; }

/* 账户与隐私 */
.privacy-card { padding: 0 24rpx; }
