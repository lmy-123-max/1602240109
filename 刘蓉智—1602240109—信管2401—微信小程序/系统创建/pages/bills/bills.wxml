<!--pages/bills/bills.wxml-->
<block wx:if="{{authState === 'checking'}}">
  <view class="loading-tip">登录状态检查中...</view>
</block>
<block wx:elif="{{authState === 'signed-out'}}">
  <view class="card" style="margin-top: 40rpx;">
    <view class="empty"><text class="empty-ico">🔐</text>请先登录后查看账单</view>
  </view>
</block>
<block wx:else>
  <view class="amount-hero card" wx:if="{{unpaidCount > 0}}">
    <view class="ah-label">待缴费金额</view>
    <view class="ah-value">¥ {{unpaidTotalText}}</view>
    <view class="ah-sub">共 {{unpaidCount}} 笔账单待支付</view>
  </view>

  <view class="tabs">
    <view class="tab {{curTab === 'unpaid' ? 'tab-on' : ''}}" data-key="unpaid" bindtap="onTab">待支付</view>
    <view class="tab {{curTab === 'paid' ? 'tab-on' : ''}}" data-key="paid" bindtap="onTab">已支付</view>
  </view>

  <block wx:if="{{loading}}">
    <view class="card"><view class="loading-tip">账单加载中...</view></view>
  </block>
  <block wx:elif="{{list.length}}">
    <view class="card bill" wx:for="{{list}}" wx:key="id">
      <view class="bill-head">
        <view class="bill-item">{{item.itemsSummary}}</view>
        <view class="bill-amount">¥ {{item.payableText}}</view>
      </view>
      <view class="bill-line">单号 {{item.billNo}}</view>
      <view class="bill-line">{{item.storeName}} · {{item.visitDateText}}</view>
      <view class="bill-line" wx:if="{{item.discount > 0}}">已抵扣挂号费 ¥{{item.discountText}}</view>
      <view class="bill-ins" wx:if="{{item.insuranceCover > 0}}">
        <text class="bi-tag">医保统筹报销 ¥{{item.insuranceCoverText}}</text>
        <text class="bi-self">自付 ¥{{item.selfPayText}}</text>
      </view>
      <view class="bill-foot">
        <view class="tag {{item.status === 1 ? 'tag-green' : 'tag-orange'}}">{{item.statusText}}</view>
        <view class="bill-channel" wx:if="{{item.payChannel}}">{{item.payChannel}}</view>
        <view class="op op-green" wx:if="{{item.status === 0}}" data-id="{{item.id}}" bindtap="onPay">立即支付</view>
      </view>
    </view>
  </block>
  <block wx:else>
    <view class="card"><view class="empty"><text class="empty-ico">💳</text>暂无{{curTabText}}账单</view></view>
  </block>
</block>
