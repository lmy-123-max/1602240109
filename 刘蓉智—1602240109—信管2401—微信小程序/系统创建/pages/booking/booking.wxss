/* pages/booking/booking.wxss */
.chip {
  display: inline-block;
  border: 2rpx solid var(--line);
  color: var(--text);
  border-radius: 32rpx;
  padding: 14rpx 30rpx;
  font-size: 26rpx;
  margin: 0 16rpx 12rpx 0;
  background: #fafbfd;
}
.chip-on { background: var(--brand-light); border-color: var(--brand); color: var(--brand); font-weight: 600; }

.doc { display: flex; align-items: center; padding: 18rpx 6rpx; border-radius: 16rpx; }
.doc-on { background: var(--brand-light); }
.doc-avatar {
  width: 76rpx; height: 76rpx; border-radius: 50%;
  background: #dcecff; color: var(--brand);
  font-size: 32rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.doc-info { flex: 1; margin: 0 16rpx; }
.doc-line { display: flex; align-items: baseline; }
.doc-name { font-size: 28rpx; font-weight: 600; }
.doc-title { font-size: 22rpx; color: var(--brand); margin-left: 12rpx; }
.doc-spec { font-size: 22rpx; color: var(--muted); margin-top: 6rpx; }
.doc-check { color: var(--brand); font-size: 34rpx; font-weight: 700; }

.date-wrap { display: flex; }
.date {
  flex-shrink: 0; width: 120rpx; text-align: center;
  border: 2rpx solid var(--line); border-radius: 18rpx;
  padding: 14rpx 0; margin-right: 16rpx; background: #fafbfd;
}
.date-on { background: var(--brand); border-color: var(--brand); color: #fff; }
.date-md { font-size: 28rpx; font-weight: 600; }
.date-wk { font-size: 22rpx; opacity: 0.75; margin-top: 4rpx; }

.slots { display: flex; flex-wrap: wrap; }
.slot {
  width: calc(50% - 12rpx);
  border: 2rpx solid var(--line); border-radius: 18rpx;
  padding: 20rpx 24rpx; margin: 0 20rpx 16rpx 0;
  box-sizing: border-box;
}
.slot:nth-child(2n) { margin-right: 0; }
.slot-on { background: var(--brand-light); border-color: var(--brand); }
.slot-full { opacity: 0.5; }
.slot-name { font-size: 28rpx; font-weight: 600; }
.slot-left { font-size: 22rpx; color: var(--mint); margin-top: 6rpx; }
.slot-full .slot-left { color: var(--muted); }

.fld { display: flex; align-items: center; padding: 18rpx 0; }
.fld + .fld { border-top: 1rpx solid var(--line); }
.fld-label { width: 130rpx; font-size: 26rpx; color: var(--muted); }
.fld-input { flex: 1; font-size: 28rpx; }

.rule { font-size: 22rpx; color: var(--muted); background: var(--warn-light); border-radius: 14rpx; padding: 16rpx 20rpx; line-height: 1.6; }

.confirm-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff; box-shadow: 0 -6rpx 24rpx rgba(31,45,61,0.08);
  display: flex; align-items: center;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  z-index: 5;
}
.confirm-info { flex: 1; min-width: 0; }
.confirm-doc { font-size: 26rpx; font-weight: 600; }
.confirm-store { font-size: 22rpx; color: var(--muted); margin-top: 4rpx; }
.confirm-btn { width: 260rpx; flex-shrink: 0; }

.mask { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.55); z-index: 10; }
.login-sheet {
  position: fixed; left: 24rpx; right: 24rpx; bottom: 0;
  background: #fff; border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  z-index: 11;
}
.login-sheet-title { font-size: 32rpx; font-weight: 700; margin-bottom: 24rpx; }
