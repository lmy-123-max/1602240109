<!--pages/appointments/appointments.wxml-->
<block wx:if="{{authState === 'checking'}}">
  <view class="loading-tip">登录状态检查中...</view>
</block>
<block wx:elif="{{authState === 'signed-out'}}">
  <view class="login-wrap card">
    <view class="login-ico">🔐</view>
    <view class="login-tip">登录后可查看您的预约记录</view>
    <login-panel bind:signedin="onSignedIn" />
  </view>
</block>
<block wx:else>
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{curTab === item.key ? 'tab-on' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTab"
    >{{item.text}}</view>
  </view>

  <block wx:if="{{loading}}">
    <view class="card"><view class="loading-tip">预约记录加载中...</view></view>
  </block>
  <block wx:elif="{{list.length}}">
    <view class="card appt" wx:for="{{list}}" wx:key="id">
      <view class="appt-head">
        <view class="appt-doc">{{item.doctorName}} <text class="appt-title">{{item.doctorTitle}}</text></view>
        <view class="tag {{item.statusCls}}">{{item.statusText}}</view>
      </view>
      <view class="appt-line">预约号：<text class="mono">{{item.appointmentNo}}</text></view>
      <view class="appt-line">就诊人：{{item.patientName}}</view>
      <view class="appt-line">时间：{{item.visitDate}} {{item.slotText}}</view>
      <view class="appt-line">门店：{{item.storeName}}</view>
      <view class="appt-ops">
        <view class="op op-blue" wx:if="{{item.status === 1 || item.status === 2 || item.status === 3}}" data-id="{{item.id}}" bindtap="goQueue">候诊进度</view>
        <view class="op op-green" wx:if="{{item.canCheckin}}" data-id="{{item.id}}" bindtap="onCheckin">到院签到</view>
        <view class="op op-blue" wx:if="{{item.status === 4}}" data-id="{{item.id}}" bindtap="goRecords">查看病历</view>
        <view class="op op-red" wx:if="{{item.status === 0 || item.status === 1}}" data-id="{{item.id}}" bindtap="onCancel">取消预约</view>
      </view>
    </view>
    <view class="bottom-space"></view>
  </block>
  <block wx:else>
    <view class="card">
      <view class="empty">
        <text class="empty-ico">🗓️</text>
        暂无{{curTabText}}的预约
        <button class="btn-ghost retry" bindtap="goBooking">去预约</button>
      </view>
    </view>
  </block>
</block>
