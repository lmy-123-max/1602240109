<!--pages/records/records.wxml-->
<block wx:if="{{authState === 'checking'}}">
  <view class="loading-tip">登录状态检查中...</view>
</block>
<block wx:elif="{{authState === 'signed-out'}}">
  <view class="card" style="margin-top: 40rpx;">
    <view class="empty"><text class="empty-ico">🔐</text>请先登录后查看病历</view>
  </view>
</block>
<block wx:else>
  <view class="sect">就诊记录</view>
  <block wx:if="{{loading}}">
    <view class="card"><view class="loading-tip">病历加载中...</view></view>
  </block>
  <block wx:elif="{{records.length}}">
    <view class="card rec" wx:for="{{records}}" wx:key="id">
      <view class="rec-head">
        <view class="rec-date">{{item.visitDate}}</view>
        <view class="tag tag-green" wx:if="{{item.hasRecall}}">复诊 {{item.recallText}}</view>
        <view class="tag tag-gray" wx:else>已完成</view>
      </view>
      <view class="rec-line">医生：{{item.doctorName}} <text class="rec-title">{{item.doctorTitle}}</text></view>
      <view class="rec-line">诊断：{{item.diagnosis}}<text wx:if="{{item.toothPosition}}">（牙位 {{item.toothPosition}}）</text></view>
      <view class="rec-line" wx:if="{{item.treatment}}">处置：{{item.treatment}}</view>
      <view class="rec-line">费用：¥{{item.totalText}} · {{item.storeName}}</view>
    </view>
  </block>
  <block wx:else>
    <view class="card">
      <view class="empty">
        <text class="empty-ico">📋</text>
        就诊后医生上传的病历将在此展示
      </view>
    </view>
  </block>

  <view class="sect">诊疗价目表</view>
  <view class="card price-card">
    <view class="price-item" wx:for="{{items}}" wx:key="id">
      <view class="price-main">
        <view class="price-name">{{item.name}}</view>
        <view class="price-cat">{{item.category}} · {{item.unit}}</view>
      </view>
      <view class="price-val">¥{{item.priceText}}</view>
    </view>
  </view>
</block>
