<!--pages/index/index.wxml-->
<view class="hero">
  <view class="hero-top">
    <view class="hero-brand">🦷 牙科门诊</view>
    <view class="hero-date">{{todayText}}</view>
  </view>
  <view class="hero-title">专业守护每一颗牙齿</view>
  <view class="hero-sub">连锁口腔门诊 · 预约挂号 · 候诊叫号 · 电子账单</view>

  <scroll-view class="store-scroll" scroll-x enable-flex>
    <view
      wx:for="{{stores}}"
      wx:key="id"
      class="store-chip {{curStore.id === item.id ? 'store-chip-on' : ''}}"
      data-id="{{item.id}}"
      bindtap="onStoreTap"
    >
      <view class="store-chip-name">{{item.name}}</view>
      <view class="store-chip-sub">{{item.open_time}}</view>
    </view>
  </scroll-view>
</view>

<view class="quick card">
  <view class="quick-item" bindtap="goBooking">
    <view class="quick-ico q-blue">📅</view>
    <view class="quick-text">预约挂号</view>
  </view>
  <view class="quick-item" bindtap="goQueue">
    <view class="quick-ico q-green">🚶</view>
    <view class="quick-text">候诊进度</view>
  </view>
  <view class="quick-item" bindtap="goBills">
    <view class="quick-ico q-orange">💳</view>
    <view class="quick-text">门诊缴费</view>
  </view>
  <view class="quick-item" bindtap="goRecords">
    <view class="quick-ico q-red">📋</view>
    <view class="quick-text">我的病历</view>
  </view>
</view>

<view class="sect">门诊公告</view>
<view class="card notice-card" wx:if="{{notices.length}}">
  <view class="notice-item" wx:for="{{notices}}" wx:key="id">
    <view class="tag tag-orange">{{item.tag}}</view>
    <view class="notice-main">
      <view class="notice-title">{{item.title}}</view>
      <view class="notice-content">{{item.content}}</view>
    </view>
  </view>
</view>
<view class="card" wx:elif="{{!loading}}"><view class="empty">暂无公告</view></view>

<view class="sect">出诊医生 · {{curStore.name}}</view>
<block wx:if="{{loading}}">
  <view class="card"><view class="loading-tip">医生信息加载中...</view></view>
</block>
<block wx:elif="{{loadError}}">
  <view class="card">
    <view class="empty">
      <text class="empty-ico">⚠️</text>
      {{loadError}}
      <button class="btn-ghost retry" bindtap="reload">重新加载</button>
    </view>
  </view>
</block>
<block wx:else>
  <view class="card doc-card" wx:for="{{doctors}}" wx:key="id">
    <view class="doc-avatar">{{item.name[0]}}</view>
    <view class="doc-main">
      <view class="doc-line1">
        <text class="doc-name">{{item.name}}</text>
        <text class="doc-title">{{item.title}}</text>
        <text class="doc-rating">★ {{item.rating}}</text>
      </view>
      <view class="doc-spec">{{item.specialty}}</view>
      <view class="doc-intro">{{item.intro}}</view>
    </view>
    <view class="doc-book" data-id="{{item.id}}" bindtap="onDoctorBook">预约</view>
  </view>
  <view class="card" wx:if="{{!doctors.length}}"><view class="empty">该门店暂无出诊医生</view></view>
</block>

<view class="stores-entry" bindtap="goStores">
  <view class="se-ico">🏠</view>
  <view class="se-main">
    <view class="se-title">门诊门店 · 地址与电话</view>
    <view class="se-sub">全部 {{stores.length}} 家门店，支持拨打电话与查看位置</view>
  </view>
  <view class="se-arrow">›</view>
</view>

<view class="footer-tip">牙科门诊 · 系统分析与设计课程演示项目</view>
